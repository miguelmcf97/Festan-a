# ── Aplicação ──
APP_ENV=development            # development | staging | production (production bloqueia o seed demo e remove a faixa de demonstração)
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://planfest:planfest@localhost:5432/planfest

# ── IA ──
# Sem chave, o planejador roda em "modo demonstração" (regras, sem LLM), usando o mesmo catálogo real.
AI_PROVIDER=anthropic          # anthropic | demo-rules
AI_MODEL=claude-sonnet-5-5     # ou claude-haiku-5-5 para reduzir custo
ANTHROPIC_API_KEY=

# ── Docker (staging/produção) ──
POSTGRES_DB=planfest
POSTGRES_USER=planfest
POSTGRES_PASSWORD=troque-por-uma-senha-forte
